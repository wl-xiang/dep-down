# npm mirrors:
#   - https://registry.npmmirror.com  # taobao. recommended
#   - https://mirrors.cloud.tencent.com/npm/
#   - https://repo.huaweicloud.com/repository/npm/
#   - https://mirrors.tuna.tsinghua.edu.cn/npm/
#   - https://mirrors.ustc.edu.cn/npm/
#   - https://registry.npmjs.org/  # default
REGISTRY=https://registry.npmmirror.com

D=./packages/

# P=./package.json
PT=./packages.txt

# when true, do as follow:
#   - if PT is empty and P is not empty, then copy P to D.
#   - secondly, generate a tarball of dir D. named packages.tar.gz in ./tarballs/
#
#   - or PT is not empty and P is empty, package.json based on PT will be generated in D.
#   - secondly, generate a tarball of dir D. named packages.tar.gz in ./tarballs/
NEED_PACK=true
