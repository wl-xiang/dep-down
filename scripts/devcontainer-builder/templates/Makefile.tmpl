# 由 scripts/devcontainer-builder 生成，请勿手工编辑。
# 平台: {{DOCKER_PLATFORM}} | 镜像 TAG: {{TAG}}（时间戳: {{TS}}）
# 本文件由 install.sh 安装到项目根目录（src root），所有 make 命令都在
# 项目根目录执行；docker-compose.yml 也在项目根目录（install.sh 复制生成），
# 挂载默认 ${SRC_ROOT:-./} 即项目根目录（可用环境变量 SRC_ROOT 覆盖）。
# docs/devcontainer/ 下是本文件的原始副本，仅用于把改坏的根目录文件
# 复制回去重置——不要在 docs/devcontainer 下直接运行任何脚本。

COMPOSE_FILE := $(abspath docker-compose.yml)
COMPOSE := docker compose -f $(COMPOSE_FILE)
DEV_RUN := $(COMPOSE) run --rm dev
IMAGES := {{IMAGE_LIST}}

# 容器默认以当前用户身份运行（compose 的 user: "${HOST_UID:-0}:${HOST_GID:-0}"），
# 避免挂载目录出现 root 属主文件（.pytest_cache/.ruff_cache 等）。
# 需要 root 时（如容器内 pip install 到系统目录）：make shell HOST_UID=0 HOST_GID=0
HOST_UID ?= $(shell id -u)
HOST_GID ?= $(shell id -g)
export HOST_UID HOST_GID

{{NPM_MAKE_VARS}}.DEFAULT_GOAL := help

# 注意：目标的说明必须写在 "## "（双井号+空格）之后，才会出现在 make help 中
help: ## 显示所有可用目标
	@grep -E '^[a-zA-Z0-9_-]+:.*## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*## "}; {printf "  %-14s %s\n", $$1, $$2}'

check: ## 离线自检：compose 文件、镜像是否已导入、容器架构是否匹配
	@echo "== docker 架构 =="
	@docker version --format '  client={{.Client.Arch}} server={{.Server.Arch}}' 2>/dev/null || echo "  (无法获取)"
	@failed=0; \
	if [ ! -f "$(COMPOSE_FILE)" ]; then \
		echo "  MISS  $(COMPOSE_FILE)   <-- 缺少 compose 运行文件，请在项目根目录重新执行 install.sh（dist/ 下：bash install.sh ../）"; failed=1; \
	fi; \
	for img in $(IMAGES); do \
		if docker image inspect "$$img" >/dev/null 2>&1; then \
			echo "  OK    $$img"; \
		else \
			echo "  MISS  $$img   <-- 请先 docker load 镜像归档 devcontainer-docker-images_{{ARCH}}_{{TS}}.tgz"; failed=1; \
		fi; \
	done; \
	if [ "$$failed" = "1" ]; then echo "== 自检失败 =="; exit 1; fi
{{NPM_CHECK}}	@echo "== 自检通过 =="

build: ## 构建镜像（需联网访问 apt/pip 源；离线机器请改用镜像归档 + make up）
	@echo "!!! make build 需要外网，离线环境请勿执行；请改用 docker load + make up !!!"
	$(COMPOSE) --profile dev build

up: ## 后台启动 prod 服务（离线，不构建不拉取）
	$(COMPOSE) up -d --no-build

down: ## 停止并移除容器与网络
	$(COMPOSE) down

ps: ## 查看容器状态
	$(COMPOSE) ps

logs: ## 跟随查看日志
	$(COMPOSE) logs -f

{{DEV_TARGETS}}{{NPM_TARGETS}}package-src: ## 重新打包 docs/devcontainer 为 tgz（输出到 dist/，可配 install.sh 再次安装）
	mkdir -p dist
	tar czf dist/devcontainer-src-repack_$$(date +%Y%m%d-%H%M%S).tgz \
		--exclude='*.tgz' --exclude='__pycache__' --exclude='.pytest_cache' \
		-C docs/devcontainer .

.PHONY: help check build up down ps logs {{PHONY_DEV}}{{PHONY_NPM}}package-src
