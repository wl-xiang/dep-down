# 由 scripts/devcontainer-builder 生成，请勿手工编辑。
# 平台: {{DOCKER_PLATFORM}} | 镜像 TAG: {{TAG}}
# compose 配置：.tpl 模板由 install.sh 渲染为 docker-compose.yaml——应用根目录
# 以绝对路径挂载为容器 /app，项目名固定为 <镜像前缀>-<应用根目录名>。
# .tpl 模板不会被 docker compose 自动发现或被 -f 误用，与用户自己的 compose
# 配置互不影响；需要调整配置时直接改渲染后的 docker-compose.yaml。
# 离线使用：镜像已由 bundle 导入，pull_policy=never + make up --no-build 不会触发任何联网。
name: {{IMAGE_PREFIX}}-{{SRC_ROOT_NAME}}
services:
  app:
    image: {{APP_IMAGE}}
    build:
      context: .
      dockerfile: Dockerfile
      target: {{APP_BUILD_TARGET}}
    working_dir: /app
    restart: unless-stopped
    pull_policy: never
    user: "${HOST_UID:-0}:${HOST_GID:-0}"
    volumes:
      - {{APP_VOLUME}}
    networks:
      - app-net
{{APP_COMMAND_BLOCK}}{{APP_OPTIONS_BLOCK}}{{DEPENDS_ON_BLOCK}}{{DEV_SERVICE_BLOCK}}{{SERVICE_BLOCKS}}
networks:
  app-net: {}
{{VOLUMES_BLOCK}}
