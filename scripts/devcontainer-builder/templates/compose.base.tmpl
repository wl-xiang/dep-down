# 由 scripts/devcontainer-builder 生成，请勿手工编辑。
# 平台: {{DOCKER_PLATFORM}} | 镜像 TAG: {{TAG}}
# 离线使用：镜像已由 bundle 导入，pull_policy=never + make up --no-build 不会触发任何联网。
services:
  app:
    image: {{IMAGE_PREFIX}}-prod:{{TAG}}
    build:
      context: .
      dockerfile: Dockerfile
      target: prod
    working_dir: /app
    restart: unless-stopped
    pull_policy: never
    user: "${HOST_UID:-0}:${HOST_GID:-0}"
    volumes:
      - {{APP_VOLUME}}
    networks:
      - app-net
{{APP_OPTIONS_BLOCK}}{{DEPENDS_ON_BLOCK}}{{DEV_SERVICE_BLOCK}}{{SERVICE_BLOCKS}}
networks:
  app-net: {}
{{VOLUMES_BLOCK}}
