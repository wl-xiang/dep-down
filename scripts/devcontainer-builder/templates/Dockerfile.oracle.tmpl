# ---- Oracle Instant Client 19（连接 Oracle 11.2 需 Thick 模式）----
# 客户端本体**不打进镜像**（减小镜像体积）：这里只安装运行依赖并配置环境
# 变量；Instant Client 由 docker-compose.yml 以只读卷的方式从宿主机挂载到
# /opt/oracle/instantclient19（可用 ORACLE_CLIENT_DIR 覆盖宿主机目录），
# 同一台服务器上的多个容器共用同一份客户端。
# - libaio1 仅存在于 bookworm（trixie 已更名 libaio1t64，装了会 exit 100）；
#   本镜像基础层固定 python:slim-bookworm，天然规避该坑。
# - libnsl2 供 Oracle 11.2 客户端使用。
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libaio1 libnsl2 \
    && rm -rf /var/lib/apt/lists/*

ENV ORACLE_HOME=/opt/oracle/instantclient19 \
    LD_LIBRARY_PATH=/opt/oracle/instantclient19 \
    TNS_ADMIN=/app \
    PATH=/opt/oracle/instantclient19:$PATH
