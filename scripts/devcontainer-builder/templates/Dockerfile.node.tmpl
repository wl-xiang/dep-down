# ---- Node.js {{NODE_VERSION}}（前端离线开发：vite / webpack / vue / react）----
# 从官方 node:slim-bookworm 镜像复制 node/npm，运行期不再依赖网络或 Debian
# 源里的旧版 nodejs/npm 包；corepack/yarn 不复制，保持镜像精简。
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates libstdc++6 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
# 删除 npm 自带的文档/手册（仅占体积，命令行功能不受影响）
RUN ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && rm -rf /usr/local/lib/node_modules/npm/docs \
              /usr/local/lib/node_modules/npm/man \
    && node -v && npm -v

# 容器默认以宿主机 UID 运行（非 root，HOME 可能不可写）：把 npm 缓存目录
# 指到 /tmp，保证 make npm-install / npm run dev 正常使用
ENV NPM_CONFIG_CACHE=/tmp/npm-cache \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false
