#!/usr/bin/env bash
# 由 scripts/devcontainer-builder 生成（时间戳: {{TS}}，镜像 TAG: {{TAG}}），请勿手工编辑。
#
# 用法：把本脚本与 devcontainer-src_{{ARCH}}_{{TS}}.tgz 放在同一目录（建议放在项目
# 根目录的 dist/ 下），然后执行：
#   bash install.sh /path/to/your/project-root     # 在 dist/ 中即 bash install.sh ../
#   bash install.sh --load /path/to/your/project-root
#                                                  # 安装开始前自动 docker load
#                                                  # 同目录的镜像归档 tgz
#   bash install.sh -d | --default                 # 一键默认安装：自动启用 --load，
#                                                  # 无需传路径，固定解压到 ../src/
#   bash install.sh -h | --help                    # 查看用法、选项与退出码
# （Artifact 的 zip 解压后可能丢失可执行权限，统一用 `bash install.sh` 调用）
#
# 作用：
#   1. 在 <SRC_ROOT>/docs/devcontainer 下解压 devcontainer-src_{{ARCH}}_{{TS}}.tgz
#      （原始副本目录，仅用于把改坏的根目录文件复制回去重置）
#   2. 把包内 docker-compose.yml.tpl 原样复制到 SRC_ROOT，命名为去掉 .tpl
#      后缀的 docker-compose.yml（模板内 ${SRC_ROOT:-./src/} 与
#      ${SRC_ROOT_NAME:-app} 由 docker compose 运行时解析，默认 ./src/）
#   3. 把 Makefile / build.sh / Dockerfile.addon(改名为 Dockerfile) /
#      README.md(改名为 README-devcontainer.md) 复制到 SRC_ROOT，
#      并安装/合并 .dockerignore 与 .gitignore
#      ——所有 make、build.sh 命令此后都在项目根目录执行
#   4. 在 SRC_ROOT/wheels/ 下创建离线安装头 requirements.txt
#      （内容 --no-index --find-links=./，缺失时才创建）
#   5. 若 SRC_ROOT 没有 main.py 且启动命令为默认值，复制占位 main.py
set -euo pipefail

NEEDS_MAIN_PY={{NEEDS_MAIN_PY}}   # 1 = prod_command 为默认 python main.py

# ---------- 输出着色（仅终端着色；重定向/CI/NO_COLOR 时自动退化为无色） ----------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
    C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_CYAN=$'\033[36m'
else
    C_RESET=''; C_BOLD=''; C_DIM=''; C_RED=''; C_GREEN=''; C_YELLOW=''; C_CYAN=''
fi
err()  { printf '%s\n' "${C_RED}错误:${C_RESET} $*"; }                  # 错误（红）
step() { printf '%s\n' "${C_BOLD}${C_CYAN}==> $*${C_RESET}"; }          # 阶段标题（青色加粗）
ok()   { printf '%s\n' "  ${C_GREEN}✓${C_RESET} $*"; }                  # 单项成功（绿勾）
note() { printf '%s\n' "  ${C_YELLOW}$*${C_RESET}"; }                   # 提示（黄）

usage() {
    local code=${1:-2}
    cat <<EOF
${C_BOLD}用法:${C_RESET} bash $0 [--load] <SRC_ROOT>
       bash $0 -d | --default

在项目根目录安装离线 devcontainer 开发环境：解压源码/模板包，安装 Makefile、
build.sh、Dockerfile、docker-compose.yml 以及 .dockerignore / .gitignore。

${C_BOLD}参数:${C_RESET}
  SRC_ROOT              项目根目录（必须已存在）。根目录操作文件安装到 SRC_ROOT，
                        原始副本与模板安装到 <SRC_ROOT>/docs/devcontainer。

${C_BOLD}选项:${C_RESET}
  -d, --default         默认安装：自动启用 --load，且无需指定 SRC_ROOT，
                        固定使用 ../src/。该选项为顶级覆盖：忽略同时给出的
                        SRC_ROOT 及其它相关自定义设置。
  --load                安装开始前自动在脚本所在目录查找
                        devcontainer-docker-images_*.tgz 并执行 docker load
                        （等效于手动 docker load -i 该归档）。
  -h, --help            显示本帮助并退出。

${C_BOLD}示例:${C_RESET}
  bash install.sh ../              # 在项目根目录的 dist/ 中安装到上一级项目根
  bash install.sh --load ../       # 同上，并在安装前自动导入镜像
  bash install.sh -d               # 一键默认：自动导入镜像并安装到 ../src/
  bash install.sh -h               # 查看本帮助

${C_BOLD}退出码:${C_RESET}
  0  安装成功（或使用 -h/--help 查看帮助）
  1  安装失败（前置校验不通过、缺少 tgz、docker load 失败等）
  2  参数错误

${C_BOLD}说明:${C_RESET}
  <SRC_ROOT>/docs/devcontainer 下是原始副本，仅用于把改坏的根目录文件
  复制回去重置；请勿在该目录下运行任何脚本。
EOF
    exit "$code"
}

LOAD_IMAGES=0
DEFAULT_MODE=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help) usage 0 ;;
        -d|--default) DEFAULT_MODE=1; shift ;;
        --load)    LOAD_IMAGES=1; shift ;;
        --)        shift; break ;;
        -*)        err "未知选项: $1"; usage ;;
        *)         break ;;
    esac
done
if [ "$DEFAULT_MODE" = "1" ]; then
    # -d/--default 为顶级覆盖：强制自动导入镜像，并固定使用默认解压路径
    # ../src/（与 CWD 相对，等价于 --load ../src/），忽略用户给出的路径与相关选项。
    LOAD_IMAGES=1
    if [ "$#" -gt 0 ]; then
        note "-d/--default 已忽略自定义路径: $*（固定使用 ../src/）"
    fi
    SRC_ROOT="../src/"
else
    [ "$#" -eq 1 ] || usage
    SRC_ROOT=$1
fi
[ -d "$SRC_ROOT" ] || { err "SRC_ROOT 不是目录: $SRC_ROOT"; exit 1; }
SRC_ROOT=$(cd "$SRC_ROOT" && pwd -P)

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd -P)

# ---------- 可选：--load 在安装开始前自动导入镜像归档 ----------
if [ "$LOAD_IMAGES" = "1" ]; then
    command -v docker >/dev/null 2>&1 \
        || { err "--load 需要 docker 命令，但未在 PATH 中检测到 docker"; exit 1; }
    shopt -s nullglob
    img_tgzs=("$SCRIPT_DIR"/devcontainer-docker-images_*.tgz)
    shopt -u nullglob
    if [ "${#img_tgzs[@]}" -eq 0 ]; then
        err "未在 $SCRIPT_DIR 找到 devcontainer-docker-images_*.tgz"
        echo "      （--load 需与镜像归档放在同一目录，即 install.sh 旁边）"
        exit 1
    fi
    if [ "${#img_tgzs[@]}" -gt 1 ]; then
        err "$SCRIPT_DIR 下有多个镜像归档，请只保留本次使用的那个："
        printf '  %s\n' "${img_tgzs[@]}"
        exit 1
    fi
    step "导入镜像归档（docker load）"
    docker load -i "${img_tgzs[0]}"
    ok "已导入 ${C_BOLD}${img_tgzs[0]}${C_RESET}"
fi

shopt -s nullglob
tgzs=("$SCRIPT_DIR"/devcontainer-src_*.tgz)
shopt -u nullglob
if [ "${#tgzs[@]}" -eq 0 ]; then
    err "未在 $SCRIPT_DIR 找到 devcontainer-src_*.tgz（请与安装脚本放在同一目录，"
    echo "      建议把 bundle zip 放到项目根目录 dist/ 下解压后执行 bash install.sh ../）"
    exit 1
fi
if [ "${#tgzs[@]}" -gt 1 ]; then
    err "$SCRIPT_DIR 下有多个 src 包，请只保留本次使用的那个："
    printf '  %s\n' "${tgzs[@]}"
    exit 1
fi
TGZ=${tgzs[0]}

DEST="$SRC_ROOT/docs/devcontainer"
COMPOSE_FILE="$SRC_ROOT/docker-compose.yml"

# 复制到项目根目录的根目录操作文件：包内文件名 -> 根目录文件名
# （Dockerfile.addon 改名 Dockerfile、README.md 改名 README-devcontainer.md，
#  避免与项目自己的 README.md 冲突）
COPY_ROOT_FILES=("Makefile:Makefile" "build.sh:build.sh" "Dockerfile.addon:Dockerfile" "README.md:README-devcontainer.md")

# ---------- 前置校验：先全部检查，再动手写盘（失败不留半套安装） ----------
fail=0
if [ -e "$DEST" ]; then
    err "$DEST 已存在。"
    echo "  重新安装请先删除该目录：rm -rf \"$DEST\"（注意保留你手工修改过的文件）"
    fail=1
fi
if [ -e "$COMPOSE_FILE" ]; then
    err "$COMPOSE_FILE 已存在，避免覆盖你的 compose 配置，安装终止。"
    echo "  请先移动/重命名该文件后重试。"
    fail=1
fi
for pair in "${COPY_ROOT_FILES[@]}"; do
    dst_name=${pair##*:}
    if [ -e "$SRC_ROOT/$dst_name" ]; then
        err "$SRC_ROOT/$dst_name 已存在，避免覆盖你自己的文件，安装终止。"
        echo "  请先移动/重命名后重试（如为旧版安装残留，确认无需保留后删除）。"
        fail=1
    fi
done
[ "$fail" = "0" ] || exit 1

# ---------- 安装 ----------
mkdir -p "$DEST"
tar xzf "$TGZ" -C "$DEST" --strip-components=1

TPL="$DEST/docker-compose.yml.tpl"
[ -f "$TPL" ] || { err "包内缺少 docker-compose.yml.tpl: $TPL"; exit 1; }

# compose 运行文件：复制模板到项目根目录，仅去掉 .tpl 后缀（不做任何渲染，
# ${SRC_ROOT:-./src/} / ${SRC_ROOT_NAME:-app} 由 docker compose 运行时解析）
step "复制 compose 模板"
cp "$TPL" "$COMPOSE_FILE"
ok "已创建 ${C_BOLD}$COMPOSE_FILE${C_RESET}"

# 根目录操作文件：从 docs/devcontainer 原始副本复制到项目根目录（改名见上）
step "安装根目录操作文件"
for pair in "${COPY_ROOT_FILES[@]}"; do
    src_name=${pair%%:*}
    dst_name=${pair##*:}
    cp "$DEST/$src_name" "$SRC_ROOT/$dst_name"
    ok "已创建 $SRC_ROOT/$dst_name ${C_DIM}(来自 $src_name)${C_RESET}"
done
# zip/tar 传输可能丢失可执行位，显式恢复
chmod 755 "$SRC_ROOT/build.sh"

# ---------- compose 命令检测：v2 插件优先，仅有 v1 独立版时改写 Makefile ----------
COMPOSE_MODE="missing"
if docker compose version >/dev/null 2>&1; then
    COMPOSE_MODE="v2"
elif command -v docker-compose >/dev/null 2>&1; then
    COMPOSE_MODE="v1"
    sed 's|^COMPOSE := docker compose |COMPOSE := docker-compose |' \
        "$SRC_ROOT/Makefile" > "$SRC_ROOT/Makefile.compose-tmp"
    mv "$SRC_ROOT/Makefile.compose-tmp" "$SRC_ROOT/Makefile"
    ok "未检测到 docker compose 插件，已将 Makefile 的 COMPOSE 改为 docker-compose"
fi

# .dockerignore / .gitignore：缺失时创建；已存在时仅追加缺失条目（不动原内容）
merge_ignore_file() {  # $1 = 包内文件名（与根目录目标同名）
    local src="$DEST/$1" dst="$SRC_ROOT/$1" line added=0
    if [ ! -e "$dst" ]; then
        cp "$src" "$dst"
        ok "已创建 $SRC_ROOT/$1"
        return
    fi
    while IFS= read -r line; do
        case "$line" in ''|'#'*) continue ;; esac
        if ! grep -qxF -- "$line" "$dst"; then
            printf '%s\n' "$line" >> "$dst"
            added=1
        fi
    done < "$src"
    if [ "$added" = "1" ]; then
        ok "已合并 $SRC_ROOT/$1 ${C_DIM}(仅追加缺失条目，原有内容未改动)${C_RESET}"
    else
        note "$SRC_ROOT/$1 已包含全部条目，未修改"
    fi
}
step "安装 .dockerignore / .gitignore"
merge_ignore_file ".dockerignore"
merge_ignore_file ".gitignore"

# wheels/requirements.txt：离线安装头（pip 会把 --find-links=./ 解析到本文件
# 所在目录，把 wheel 放进 wheels/ 后即可 pip install -r wheels/requirements.txt <包名>）
mkdir -p "$SRC_ROOT/wheels"
REQ_FILE="$SRC_ROOT/wheels/requirements.txt"
if [ ! -e "$REQ_FILE" ]; then
    printf -- '--no-index --find-links=./\n' > "$REQ_FILE"
    ok "已创建 $REQ_FILE（离线安装头）"
fi

if [ "$NEEDS_MAIN_PY" = "1" ] && [ ! -e "$SRC_ROOT/main.py" ]; then
    cp "$DEST/main.py" "$SRC_ROOT/main.py"
    ok "已创建占位入口 $SRC_ROOT/main.py（make up 默认运行 python main.py，请替换为真实入口）"
fi

# npm 离线包目录（默认项目根目录 packages/）：提前创建，避免 docker 以 root
# 身份自动创建空目录；产物由 Npm Download Action 解压后放入该目录。
if [ "{{NODE_ENABLED}}" = "1" ]; then
    case "{{NPM_PACKAGES_DIR}}" in
        /*)
            note "npm 离线包目录为绝对路径 {{NPM_PACKAGES_DIR}}（不在项目根内，install.sh 不创建）"
            ;;
        *)
            mkdir -p "$SRC_ROOT/{{NPM_PACKAGES_DIR}}"
            ok "已准备 npm 离线包目录 $SRC_ROOT/{{NPM_PACKAGES_DIR}}（放入 Npm Download 产物的 packages/ 内容）"
            ;;
    esac
fi

echo ""
printf '%s\n' "${C_GREEN}${C_BOLD}== 安装完成 ==${C_RESET}"
echo "项目根目录: ${C_BOLD}$SRC_ROOT${C_RESET}"
if [ "$LOAD_IMAGES" = "1" ]; then
    if [ "$DEFAULT_MODE" = "1" ]; then
        echo "镜像: 已导入（-d/--default）"
    else
        echo "镜像: 已导入（--load）"
    fi
else
    echo "镜像: cd \"$SCRIPT_DIR\" && docker load -i devcontainer-docker-images_{{ARCH}}_{{TS}}.tgz"
fi
echo "启动: cd \"$SRC_ROOT\" && ${C_GREEN}make check && make up && make logs${C_RESET}"
echo "更多: make help（docs/devcontainer 为原始副本，可重置根目录文件）"
if [ "$COMPOSE_MODE" = "v1" ]; then
    note "已将 Makefile 的 COMPOSE 设为 docker-compose"
elif [ "$COMPOSE_MODE" = "missing" ]; then
    printf '%s\n' "${C_RED}${C_BOLD}警告: 未检测到 docker compose 或 docker-compose，make 命令无法执行，请先安装 docker compose。${C_RESET}"
fi
{{ORACLE_NOTICE_BLOCK}}{{NPM_NOTICE_BLOCK}}
