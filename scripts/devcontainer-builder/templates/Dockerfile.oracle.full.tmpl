# ---- Oracle Instant Client 19 完整安装（连接 Oracle 11.2 需 Thick 模式）----
# 参考 https://github.com/wl-xiang/oracle2excel/blob/main/Dockerfile：
# 安装运行时依赖，并在构建期从 Oracle 官方公开直链下载 Instant Client 19
# Basic 包解压进镜像（x64 / arm64 由 BuildKit 的 TARGETARCH 决定）。
# 客户端随镜像分发，无需宿主机挂载；oracledb 以 Thick 模式直接可用。
# - libaio1 仅存在于 bookworm（trixie 已更名 libaio1t64，装了会 exit 100）；
#   本镜像基础层固定 python:slim-bookworm，天然规避该坑。
# - libnsl2 供 Oracle 11.2 客户端使用。
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libaio1 libnsl2 wget unzip \
    && rm -rf /var/lib/apt/lists/*

# 下载后校验 libclntsh.so.19.1 的 ELF 机器类型与目标架构一致
# （62=x86-64, 183=aarch64），防止架构错配静默通过构建。
# TARGETARCH 由 BuildKit 根据 --platform 自动注入；未启用 BuildKit 时回退到构建机 uname
ARG TARGETARCH
RUN mkdir -p /opt/oracle \
    && ARCH="${TARGETARCH:-$(uname -m | sed -e 's/^x86_64$/amd64/' -e 's/^aarch64$/arm64/')}" \
    && case "$ARCH" in \
        amd64) IC_URL="https://download.oracle.com/otn_software/linux/instantclient/1919000/instantclient-basic-linux.x64-19.19.0.0.0dbru.zip" ;; \
        arm64) IC_URL="https://download.oracle.com/otn_software/linux/instantclient/1919000/instantclient-basic-linux.arm64-19.19.0.0.0dbru.zip" ;; \
        *) echo "[错误] 不支持的目标架构: $ARCH" >&2; exit 1 ;; \
    esac \
    && wget -q --timeout=60 "$IC_URL" -O /tmp/instantclient.zip \
    && unzip -q /tmp/instantclient.zip -d /tmp/instantclient \
    && mkdir -p /opt/oracle/instantclient19 \
    && cp -a /tmp/instantclient/instantclient_19_19/. /opt/oracle/instantclient19/ \
    && rm -rf /tmp/instantclient /tmp/instantclient.zip \
    && ls /opt/oracle/instantclient19/libclntsh.so.19.1 \
    && python -c "import sys; d=open('/opt/oracle/instantclient19/libclntsh.so.19.1','rb').read(20); exp={'amd64':62,'arm64':183}[sys.argv[1]]; assert int.from_bytes(d[18:20],'little')==exp, 'Instant Client ELF 架构与目标平台不一致'" "$ARCH"

ENV ORACLE_HOME=/opt/oracle/instantclient19 \
    LD_LIBRARY_PATH=/opt/oracle/instantclient19 \
    TNS_ADMIN=/app \
    PATH=/opt/oracle/instantclient19:$PATH
