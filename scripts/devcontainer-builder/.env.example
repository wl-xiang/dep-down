# sync.py / flush.py 环境变量模板。
# 复制为 .env 后填入真实值（.env 已被 gitignore 模板忽略，请勿提交真实密钥）。
# sync.py 加载顺序：当前目录 .env -> 本脚本所在目录 .env；已有的进程环境变量优先。

# 远端部署服务器（SSH 连接账户，用于 SFTP 上传）
SYNC_REMOTE_HOST=
SYNC_REMOTE_PORT=
SYNC_REMOTE_USER=
SYNC_REMOTE_PASSWORD=

# 远端项目部署路径（src 压缩包与 sync.json 的上传目录）
SYNC_REMOTE_PATH=

# 代码打包方式: tgz | zip（留空默认 tgz）
SYNC_ARCHIVE_FORMAT=
