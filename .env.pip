# pip mirrors:
#   - https://pypi.org/simple (none as default)
#   - https://pypi.tuna.tsinghua.edu.cn/simple
#   - https://mirrors.aliyun.com/pypi/simple
#   - https://pypi.mirrors.ustc.edu.cn/simple/
INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# [linux, win]
PLATFORM=linux

# [amd64|x86_64, arm64|aarch64]
ARCH=amd64

# [36, 38, 39, 310, 311, 312, ...]
PYTHON_VERSION=312

D=./wheels
R=./requirements.txt

# when true, do as follow:
#   - first, copy R to D.
#   - second, generate a tarball of dir D. named wheels_${PLATFORM}_${ARCH}_${PYTHON_VERSION}.tar.gz in ./tarballs/
NEED_PACK=true